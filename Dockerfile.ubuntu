#############################################
# Fallback Dockerfile (Ubuntu 基础镜像) - 适用于无法从 Docker Hub 拉取 python:*-slim 的情况
# 使用 ubuntu:22.04 + deadsnakes PPA 安装 Python 3.10
#############################################

FROM ubuntu:22.04 AS base
ENV DEBIAN_FRONTEND=noninteractive \
    PIP_NO_CACHE_DIR=1 \
    MPLBACKEND=Agg \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN sed -i 's@archive.ubuntu.com@mirrors.aliyun.com@g' /etc/apt/sources.list && \
    sed -i 's@security.ubuntu.com@mirrors.aliyun.com@g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
        software-properties-common build-essential git curl wget ca-certificates \
        libglib2.0-0 libsm6 libxrender1 libxext6 libfreetype6 libpng16-16 tzdata && \
    add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update && apt-get install -y --no-install-recommends python3.10 python3.10-distutils python3.10-venv python3-pip && \
    ln -sf /usr/bin/python3.10 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

# 升级 pip & 设置国内源
RUN python -m pip install --upgrade pip && \
    pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple && \
    pip config set global.trusted-host pypi.tuna.tsinghua.edu.cn

COPY requirements.txt ./requirements.txt
RUN pip install -r requirements.txt

COPY . .
ENV PYTHONPATH="/app/src"
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

CMD ["python", "-c", "print('Ubuntu fallback image ready. Run: python examples/fc_timesfm_score.py')"]
